<Application
    x:Class="WID.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WID"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Application.Resources>        
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <!-- Other app resources here -->
            <Style x:Key="InkToolbarIcon" TargetType="FontIcon">
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <RotateTransform Angle="180" />
                    </Setter.Value>
                </Setter>
                <Setter Property="Foreground" Value="White" />
                <Setter Property="RenderTransformOrigin" Value="0.5, 0.5" />
                <Setter Property="FontSize" Value="36" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
            </Style>
            
            <Style x:Key="SettingsPageOption" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                <Setter Property="FontSize" Value="20" />
            </Style>
            
            <Style x:Key="SettingsPageSectionHeader" TargetType="TextBlock" BasedOn="{StaticResource SettingsPageOption}">
                <Setter Property="FontSize" Value="32" />
                <Setter Property="FontWeight" Value="Bold" />
            </Style>
            
            <Style x:Key="SettingsPageSectionPanel" TargetType="StackPanel">
                <Setter Property="Orientation" Value="Vertical" />
                <Setter Property="Spacing" Value="12" />
            </Style>

            <Style x:Key="SettingsPageOptionPanel" TargetType="StackPanel">
                <Setter Property="Orientation" Value="Vertical" />
                <Setter Property="Spacing" Value="6" />
            </Style>

            <Style x:Key="SettingsPageComboBox" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
                <Setter Property="Width" Value="256" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
