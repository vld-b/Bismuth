<Page
    x:Class="WID.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WID"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer
        Padding="48, 48, 0, 0"
        VerticalAlignment="Stretch"
        HorizontalAlignment="Stretch"
        VerticalScrollMode="Enabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Visible"
        HorizontalScrollBarVisibility="Disabled"
        >
        <StackPanel
            Orientation="Vertical"
            Spacing="32"
            >
            <StackPanel
                Style="{StaticResource SettingsPageSectionPanel}"
                >
                <TextBlock
                    Text="Home screen"
                    Style="{StaticResource SettingsPageSectionHeader}"
                    />

                <StackPanel
                    Style="{StaticResource SettingsPageOptionPanel}"
                    >
                    <TextBlock
                        Text="Thumbnail size"
                        Style="{StaticResource SettingsPageOption}"
                        />

                    <ComboBox
                        x:Name="cbxHomeScreenThumbnailSize"
                        SelectionChanged="ChangeHomescreenThumbnailSize"
                        Style="{StaticResource SettingsPageComboBox}"
                        >
                        <x:String>Small</x:String>
                        <x:String>Medium</x:String>
                        <x:String>Large</x:String>
                    </ComboBox>
                </StackPanel>
            </StackPanel>

            <StackPanel
                Style="{StaticResource SettingsPageSectionPanel}"
                >
                <TextBlock
                    Text="Note-taking experience"
                    Style="{StaticResource SettingsPageSectionHeader}"
                    />

                <StackPanel
                    Style="{StaticResource SettingsPageOptionPanel}"
                    >
                    <TextBlock
                        Text="Input devices"
                        Style="{StaticResource SettingsPageOption}"
                        />
                    <CheckBox
                        x:Name="cbInputMouse"
                        Content="Mouse"
                        Checked="InputDeviceChecked"
                        Unchecked="InputDeviceUnchecked"
                        />
                    <CheckBox
                        x:Name="cbInputPen"
                        Content="Pen"
                        Checked="InputDeviceChecked"
                        Unchecked="InputDeviceUnchecked"
                        />
                    <CheckBox
                        x:Name="cbInputTouch"
                        Content="Touch"
                        Checked="InputDeviceChecked"
                        Unchecked="InputDeviceUnchecked"
                        />
                </StackPanel>

                <StackPanel
                    Style="{StaticResource SettingsPageOptionPanel}"
                    >
                    <TextBlock
                        Text="Ink toolbar placement"
                        Style="{StaticResource SettingsPageOption}"
                        />

                    <ComboBox
                        x:Name="cbxInkToolbarPlacement"
                        SelectionChanged="ChangeInkToolbarPlacement"
                        Style="{StaticResource SettingsPageComboBox}"
                        >
                        <x:String>Top</x:String>
                        <x:String>Bottom</x:String>
                    </ComboBox>
                </StackPanel>

                <StackPanel
                    Style="{StaticResource SettingsPageOptionPanel}"
                    >
                    <TextBlock
                        Text="Undo/Redo buttons placement"
                        Style="{StaticResource SettingsPageOption}"
                        />

                    <ComboBox
                        x:Name="cbxUndoRedoButtonsPlacement"
                        SelectionChanged="ChangeUndoRedoButtonsPlacement"
                        Style="{StaticResource SettingsPageComboBox}"
                        >
                        <x:String>Top left</x:String>
                        <x:String>Top right</x:String>
                        <x:String>Bottom left</x:String>
                        <x:String>Bottom right</x:String>
                    </ComboBox>
                </StackPanel>

                <StackPanel
                    Style="{StaticResource SettingsPageOptionPanel}"
                    >
                    <TextBlock
                        Text="Default language for ink recognition"
                        Style="{StaticResource SettingsPageOption}"
                        />

                    <ComboBox
                        x:Name="cbxDefaultInkLanguage"
                        SelectionChanged="ChangeDefaultInkLanguage"
                        Style="{StaticResource SettingsPageComboBox}"
                        >
                    </ComboBox>

                    <Button
                        Click="GetMoreInkLanguages"
                        >
                        Get more ink languages
                    </Button>
                </StackPanel>

                <StackPanel
                    Style="{StaticResource SettingsPageOptionPanel}"
                    >
                    <TextBlock
                        Text="Use select lasso with right click"
                        Style="{StaticResource SettingsPageOption}"
                        />

                    <ToggleSwitch
                        x:Name="tsSelectWithRightClick"
                        Toggled="ChangeSelectWithRightClick"
                        />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
