<Page
    x:Class="WID.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WID"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer
        Padding="48, 48, 0, 0"
        VerticalAlignment="Stretch"
        HorizontalAlignment="Stretch"
        VerticalScrollMode="Enabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Visible"
        HorizontalScrollBarVisibility="Disabled"
        >
        <StackPanel
            Orientation="Vertical"
            Spacing="64"
            >
            <StackPanel
                Orientation="Vertical"
                Spacing="12"
                >
                <TextBlock
                    Text="Input devices"
                    FontSize="32"
                    FontWeight="Bold"
                    />
                <CheckBox
                    x:Name="cbInputMouse"
                    Content="Mouse"
                    Checked="InputDeviceChecked"
                    Unchecked="InputDeviceUnchecked"
                    />
                <CheckBox
                    x:Name="cbInputPen"
                    Content="Pen"
                    Checked="InputDeviceChecked"
                    Unchecked="InputDeviceUnchecked"
                    />
                <CheckBox
                    x:Name="cbInputTouch"
                    Content="Touch"
                    Checked="InputDeviceChecked"
                    Unchecked="InputDeviceUnchecked"
                    />
            </StackPanel>

            <StackPanel
                Orientation="Vertical"
                Spacing="12"
                >
                <TextBlock
                    Text="Home screen"
                    FontSize="32"
                    FontWeight="Bold"
                    />

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8"
                    >
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="Thumbnail size"
                        FontSize="16"
                        />

                    <ComboBox
                        x:Name="cbxHomeScreenThumbnailSize"
                        SelectionChanged="ChangeHomescreenThumbnailSize"
                        >
                        <x:String>Small</x:String>
                        <x:String>Medium</x:String>
                        <x:String>Large</x:String>
                    </ComboBox>
                </StackPanel>
            </StackPanel>

            <StackPanel
                Orientation="Vertical"
                Spacing="12"
                >
                <TextBlock
                    Text="Note-taking experience"
                    FontSize="32"
                    FontWeight="Bold"
                    />

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8"
                    >
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="Ink toolbar placement"
                        FontSize="16"
                        />

                    <ComboBox
                        x:Name="cbxInkToolbarPlacement"
                        SelectionChanged="ChangeInkToolbarPlacement"
                        >
                        <x:String>Top</x:String>
                        <x:String>Bottom</x:String>
                    </ComboBox>
                </StackPanel>

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8"
                    >
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="Undo/Redo buttons placement"
                        FontSize="16"
                        />

                    <ComboBox
                        x:Name="cbxUndoRedoButtonsPlacement"
                        SelectionChanged="ChangeUndoRedoButtonsPlacement"
                        >
                        <x:String>Top left</x:String>
                        <x:String>Top right</x:String>
                        <x:String>Bottom left</x:String>
                        <x:String>Bottom right</x:String>
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
